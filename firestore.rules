rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Доступ только двум пользователям. По умолчанию всё остальное закрыто.
    function isMember() {
      return request.auth != null
        && (request.auth.uid == 'qSCqveMBppaTLRyGfUv18b6rk0J2' || request.auth.uid == 'cdlZ4CPKEkY91fvct7mRI52Zdwv1');
    }

    match /rooms/main {
      allow read: if isMember();
      allow write: if false; // комнату создаём вручную
    }

    match /rooms/main/messages/{messageId} {
      allow read: if isMember();
      // v1: только текст. photo за флагом ENABLE_MEDIA (чтение старых photo ок).
      allow create: if isMember()
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.clientMessageId is string
        && request.resource.data.clientTs is number
        && request.resource.data.kind == 'text';
      // v1: receipts (deliveredAt/readAt) выкл за флагом ENABLE_RECEIPTS.
      // Никаких update из onSnapshot — иначе loop и flood Write/channel.
      allow update: if false;
      allow delete: if false;
    }

    match /media/{mediaId} {
      allow read: if isMember();
      allow create: if isMember()
        && request.resource.data.senderId == request.auth.uid;
      allow update, delete: if false;
    }

    match /pushSubscriptions/{uid} {
      // каждый пишет только свою подписку
      allow read, write: if request.auth != null && request.auth.uid == uid && isMember();
    }

    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid && isMember();
    }

    match /debug-ping/{uid} {
      // техническая коллекция для кнопки «Тест записи» (?debug-панель)
      allow read, write: if request.auth != null && request.auth.uid == uid && isMember();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
