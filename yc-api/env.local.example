# Локальные секреты для деплоя yc-api. НЕ В GIT (покрыто .gitignore: *.local).
# Скопируй: cp yc-api/.env.local.example yc-api/.env.local  и заполни.
# Значения FIREBASE_*/ALLOWED_UIDS/VAPID_* — те же, что сейчас в Vercel env.
# GOOGLE_SERVICE_ACCOUNT_JSON — целиком JSON-ключ нового SA для Drive.
YC_FUNCTION=ns-api
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account", ... вставь целиком ...}
ALLOWED_UIDS=qSCqveMBppaTLRyGfUv18b6rk0J2,cdlZ4CPKEkY91fvct7mRI52Zdwv1
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account", ... вставь целиком ...}
DRIVE_FOLDER_ID=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
FRONTEND_ORIGINS=https://stepierk.github.io
